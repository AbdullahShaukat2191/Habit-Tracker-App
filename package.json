{
  "name": "habit-tracker",
  "version": "1.21.0",
  "_buildConfigNote": "package.json's \"build\" field is the sole electron-builder config in use. electron-builder.config.js was removed as dead config — electron-builder never actually read it (verified: it never reads a standalone .js config unless invoked with --config, which no script here does).",
  "description": "Desktop habit tracker — command center for discipline",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -n next,electron -c cyan,yellow \"next dev\" \"tsc -p tsconfig.electron.json && wait-on http://localhost:3000 && electron .\"",
    "dev:next": "next dev",
    "dev:electron": "tsc -p tsconfig.electron.json && electron .",
    "build": "next build && tsc -p tsconfig.electron.json && electron-builder",
    "build:next": "next build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "package": "electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "auto-launch": "^5.0.6",
    "better-sqlite3": "^11.7.0",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.38.0",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "14.2.21",
    "openai": "^6.45.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.habittracker.app",
    "productName": "Habit Tracker",
    "copyright": "Copyright © 2026",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      },
      {
        "from": "data",
        "to": "data"
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*",
      "**/node_modules/bindings/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/canvas-confetti": "^1.6.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "drizzle-kit": "^0.30.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^29.7.0",
    "playwright": "^1.60.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}
